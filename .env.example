# Токен бота, полученный у @BotFather
BOT_TOKEN=

# Необязательно: API-ключ TronScan (https://tronscan.org/#/tools/api) — снимает лимиты на запросы
TRON_API_KEY=

# Необязательно: Telegram user id, который единственный сможет настраивать бота.
# Если не задан — им станет тот, кто первым пришлёт /start и укажет кошелек.
OWNER_ID=

# Как часто проверять новые поступления, в секундах
POLL_INTERVAL=15

# Часовой пояс для ежедневной полночной очистки чата (IANA-имя, например Europe/Moscow)
TIMEZONE=UTC
